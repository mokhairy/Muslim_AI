# Base configuration
DJANGO_SETTINGS_MODULE=Muslim_AI.settings_development
DJANGO_SECRET_KEY=replace-this-in-real-deployments
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Muscat

# Development
DJANGO_DEBUG=1

# Production security
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_TRUST_X_FORWARDED_PROTO=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# Worker
PRAYER_AUTOMATION_INTERVAL=20
