{
  "expo": {
    "name": "Muslim AI",
    "slug": "muslim-ai-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "usesAppleSignIn": false,
      "bundleIdentifier": "ca.geointel.muslimai",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Muslim AI uses your location to calculate prayer times and qibla direction.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ca.geointel.muslimai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#003527"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "5b5f474e-1440-4dc8-903f-34c9fc373cac"
      }
    }
  }
}
